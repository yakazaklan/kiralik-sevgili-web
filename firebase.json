{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log",
        "functions-debug.log"
      ]
    }
  ],
  "hosting": [
    {
      "site": "kiralik-sevgili-web",
      "public": "out",
      "cleanUrls": true,
      "trailingSlash": true,
      "rewrites": [
        {
          "source": "/api/send-deletion-request/",
          "function": "sendDeletionRequest"
        },
        {
          "source": "/api/verify-deletion/",
          "function": "verifyDeletion"
        },
        {
          "source": "/profil/duzenle/**",
          "destination": "/profil/duzenle/index.html"
        },
        {
          "source": "/profil/ilan-detay/**",
          "destination": "/profil/ilan-detay/index.html"
        },
        {
          "source": "/profil/**",
          "destination": "/profil/ilan-detay/index.html"
        }
      ],
      "headers": [
        {
          "source": "/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ]
}
