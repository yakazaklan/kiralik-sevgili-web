{
  "hosting": [
    {
      "site": "kiralik-sevgili",
      "public": "out",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/profil/**",
          "destination": "/profil/ilan-detay.html"
        },
        {
          "source": "/post/**",
          "destination": "/index.html"
        },
        {
          "source": "/story/**",
          "destination": "/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "site": "kiralik-sevgili-web",
      "public": "out",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/profil/**",
          "destination": "/profil/ilan-detay.html"
        },
        {
          "source": "/post/**",
          "destination": "/index.html"
        },
        {
          "source": "/story/**",
          "destination": "/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
